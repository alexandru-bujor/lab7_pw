# Development Dockerfile with hot reload using Air
FROM golang:1.23-alpine

# Install Air for hot reload (using v1.49.0 which is compatible with Go 1.23)
RUN go install github.com/cosmtrek/air@v1.49.0

# Install git and other build tools
RUN apk add --no-cache git

# Set working directory
WORKDIR /app

# Create tmp directory for Air builds
RUN mkdir -p /app/tmp

# Copy go mod files first for better caching
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy Air configuration
COPY .air.toml ./

# Expose port
EXPOSE 8080

# Use Air to run the application with hot reload
CMD ["air", "-c", ".air.toml"]
